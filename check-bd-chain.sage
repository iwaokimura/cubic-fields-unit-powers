# check-bd-chain.sage --- E102: the Betts-Dogra chain mu_F -> j_Gamma -> h_ell,
# checked against a published example, and the factor 4 located.
#
# Run: sage check-bd-chain.sage
#
# WHY.  E101 measured epsilon = 1/2, so the port's theta is half the
# Coleman-Gross h_p and the system's c_3 is half the true h_3:
#
#     h_3(R) = 2 c_3 = -(m_2/2) log_13(3)   [E093 + E101]
#
# while E084's mu_Z with E086's c predicts -+(m_2/8) log_13(3) for the port's Z.
# A factor 4.  E101 localised it in the local chain rather than in the port --
# B is now measured against an external standard -- and this gate finds where.
#
# THE TEST BED.  BDMTV2023 Example (C_161 at ell = 7) publishes BOTH ends of the
# chain for a curve with a fully described graph:
#
#   Gamma_7 : three genus-0 vertices w_0, w_1, w_2; w_0 meets w_1 in two points
#             (e_1, e_2) and w_2 in two points (e_3, e_4); w_0 is the source of
#             e_1, e_3 and the target of e_2, e_4.
#   H_1     : generated by gamma_1 = e_1 + e_2 and gamma_2 = e_3 + e_4.
#   Z|H_1   : [[a, b], [c, -a]], trace zero.
#   THEY STATE:  mu_Z = (a/2)(gamma_1 - gamma_2),  "since both edges have
#                length 2",  and  j_Gamma takes the values  a, 0, -a.
#
# Every component has genus 0, so V_p(X_w) = 0 and the VERTEX term of mu_F
# vanishes identically: this example isolates the EDGE term and the Laplacian,
# which is exactly the half of Theorem 3.2 that E084 had to repair.
#
# WHAT COMES OUT.  Our implementation of the printed formulae reproduces their
# mu_Z exactly, and then gives j = (0, a/4, -a/4) where they state (0, a, -a).
# A FACTOR 4, on their example, with no input of ours in it.  And the same
# factor 4 applied to E084's j_Gamma(R) = 1/8 makes the prediction for C_4 agree
# with E101's measurement EXACTLY, sign included.

import sys, time

FAIL = []


def check(cond, msg):
    ok = bool(cond)
    print("   %s %s" % ("[ok] " if ok else "[FAIL]", msg))
    if not ok:
        FAIL.append(msg)
    sys.stdout.flush()
    return ok


def info(msg):
    print("        %s" % msg)
    sys.stdout.flush()


def edge_mu(edges, cycles, ZH, use_length, K=QQ):
    """mu_e = (1/l(e))^{use_length} e^* F(pi(e)), pi orthogonal for e.e' = delta.

    cycles: rows of a matrix whose rows are a basis of H_1 in Q^E.
    ZH: the matrix of F on H_1 in that basis.
    """
    E = len(edges)
    G = matrix(K, cycles)
    Gram = G * G.transpose()
    out = []
    for i in range(E):
        ei = vector(K, [1 if k == i else 0 for k in range(E)])
        c = Gram.inverse() * (G * ei)          # coords of pi(e_i) in the basis
        v = (G.transpose() * (matrix(K, ZH) * c))
        out.append(v[i] / (edges[i][2] if use_length else 1))
    return out


def solve_j(edges, mu_e, mu_v, base, K=QQ):
    """The unique piecewise-quadratic j with nabla^2 j = mu and j(base) = 0.

    On e, parametrised by [0, l(e)] from source to target,
        j_e(x) = -(mu_e/2) x^2 + beta_e x + j(s),
        beta_e = (j(t) - j(s))/l + mu_e l/2,     j_e'(l) = beta_e - mu_e l,
    and the vertex equation is  mu_v = sum_{s(e)=v} j_e'(0) - sum_{t(e)=v} j_e'(l).
    """
    V = max(max(e[0], e[1]) for e in edges) + 1
    R = PolynomialRing(K, ['J%d' % k for k in range(V)])
    JV = list(R.gens())
    rows, rhs = [], []
    for v in range(V):
        expr = R.zero()
        for i, (s, t, L) in enumerate(edges):
            beta = (JV[t] - JV[s])/L + R(mu_e[i]*L/2)
            if s == v:
                expr += beta
            if t == v:
                expr -= beta - R(mu_e[i]*L)
        rows.append([expr.coefficient(JV[k]) for k in range(V)])
        rhs.append(K(mu_v[v]) - expr.constant_coefficient())
    rows.append([1 if k == base else 0 for k in range(V)])
    rhs.append(K(0))
    A = matrix(K, rows)
    return A.solve_right(vector(K, rhs))


def main():
    t0 = time.time()
    print("=== check-bd-chain.sage --- E102: the Betts-Dogra chain, checked ===")

    print("(1) BDMTV2023's C_161 AT ell = 7, WHICH PUBLISHES BOTH ENDS")
    # e_1 : w0 -> w1,  e_2 : w1 -> w0,  e_3 : w0 -> w2,  e_4 : w2 -> w0
    CYC = [[1, 1, 0, 0], [0, 0, 1, 1]]
    Ra = PolynomialRing(QQ, 'a')
    a = Ra.gen()
    ZH = [[a, 0], [0, -a]]                     # b, c do not enter mu_e
    for LEN in (QQ(1), QQ(2)):
        ed = [(0, 1, LEN), (1, 0, LEN), (0, 2, LEN), (2, 0, LEN)]
        for ul in (True, False):
            me = edge_mu(ed, CYC, ZH, ul, Ra)
            jj = solve_j(ed, me, [Ra(0)]*3, 0, Ra.fraction_field())
            info("l(e) = %s, %s 1/l(e):   mu_e = %s   ->   j = %s"
                 % (LEN, "with" if ul else "without",
                    [str(m) for m in me], [str(c) for c in jj]))
    ed1 = [(0, 1, QQ(1)), (1, 0, QQ(1)), (0, 2, QQ(1)), (2, 0, QQ(1))]
    me1 = edge_mu(ed1, CYC, ZH, True, Ra)
    j1 = solve_j(ed1, me1, [Ra(0)]*3, 0, Ra.fraction_field())
    check(me1 == [a/2, a/2, -a/2, -a/2],
          "with the printed mu_F and edges of length 1, the edge part is "
          "(a/2)(gamma_1 - gamma_2) -- EXACTLY what BDMTV2023 state.  The "
          "vertex part vanishes because every component has genus 0, so this "
          "example isolates the edge term  [T(CAS)]")
    check(list(j1) == [0, a/4, -a/4],
          "and solving nabla^2 j = mu then gives j = (0, a/4, -a/4), where "
          "THE PAPER STATES (a, 0, -a).  A FACTOR 4, on their own example, "
          "with nothing of ours in it  [T(CAS)]")
    ed2 = [(0, 1, QQ(2)), (1, 0, QQ(2)), (0, 2, QQ(2)), (2, 0, QQ(2))]
    me2 = edge_mu(ed2, CYC, ZH, False, Ra)
    j2 = solve_j(ed2, me2, [Ra(0)]*3, 0, Ra.fraction_field())
    check(me2 == [a/2, a/2, -a/2, -a/2] and list(j2) == [0, a, -a],
          "the ONE reading that reproduces both of their statements is: edges "
          "of length 2 AND the factor 1/l(e) dropped.  Then mu_e = a/2 and "
          "j = (0, a, -a).  So the paper's two sentences pin a convention that "
          "its own printed formula does not")

    print("(2) THE SAME CHAIN ON C_4 AT ell = 3  [regression on E084]")
    EDG = [(0, 1, QQ(1)/6), (0, 1, QQ(1)/6), (1, 2, QQ(1)/12)]
    VN = ["Ebar'", "R", "F"]
    gam = [[1, -1, 0]]
    meC = edge_mu(EDG, gam, [[-1]], True)
    check(meC == [-3, -3, 0],
          "edge part (1/l(e)) e^* Z(pi(e)) = %s, E084's numbers exactly"
          % [str(m) for m in meC])
    mvC = [QQ(2), QQ(0), QQ(-1)]
    check(sum(mvC) != sum(meC[i]*EDG[i][2] for i in range(3)),
          "and (*) fails as E084 found: sum_v mu_v = %s against "
          "sum_e mu_e l(e) = %s" % (sum(mvC),
                                    sum(meC[i]*EDG[i][2] for i in range(3))))
    jC = solve_j(EDG, [-m for m in meC], mvC, 0)
    check(jC[0] == 0 and jC[1] == QQ(1)/8 and jC[2] == QQ(5)/24,
          "with the edge part negated -- E084's repair -- the solver returns "
          "j_Gamma = (0, 1/8, 5/24), reproducing E084 exactly.  So the two "
          "sections agree and the discrepancy is not an arithmetic slip")

    print("(3) THE FACTOR 4, AND THE MEASUREMENT")
    m2 = QQ(16848)
    lamZ = QQ(-16848)
    pred_old = lamZ * jC[1]
    pred_new = lamZ * 4 * jC[1]
    meas = -m2/2                     # h_3 = 2 c_3, E093 corrected by E101
    info("E084's j_Gamma(R) = %s;  predicted h_3(R)/log_13(3) = c/|c| * %s"
         % (jC[1], pred_old))
    info("times 4:                              %s" % pred_new)
    info("MEASURED h_3(R)/log_13(3) = 2 c_3 =   %s" % meas)
    check(pred_new == meas,
          "the corrected prediction and the measurement agree EXACTLY, sign "
          "included: -(m_2/2) log_13(3) both sides, with c = +log_13(3).  The "
          "factor between E084's j_Gamma and the truth is 4 -- the SAME 4 that "
          "group (1) found on BDMTV2023's own published example  [E: 2 cases]")
    check(pred_old != meas and 4*pred_old == meas,
          "and it is exactly 4, not 2: E088 read the discrepancy as 2 because "
          "it compared against theta rather than against h_p, and E101 showed "
          "theta = h_p/2")

    print("(4) WHAT THIS DOES AND DOES NOT SETTLE")
    info("SETTLED: the chain mu_F -> j_Gamma -> h_ell, as this project reads "
         "the printed formulae, is out by a factor 4, and the factor is "
         "reproduced independently on BDMTV2023's own worked example.  "
         "Correcting it makes E084's prediction for C_4 at ell = 3 agree with "
         "E101's measurement exactly, sign included.  That is the first time "
         "the ell-adic side of this project has been validated against "
         "anything.")
    info("NOT SETTLED: which convention is right.  Group (1) shows the paper's "
         "two statements about C_161 are consistent only if the edges have "
         "length 2 and the 1/l(e) is dropped -- and that reading breaks the "
         "consistency condition (*) for C_4, where the printed 1/l(e) is "
         "exactly what makes sum_e mu_e l(e) = Tr(F|H_1).  So the empirical "
         "factor 4 is on firmer ground than any of the readings that might "
         "explain it.")
    info("CONSEQUENCES.  Upsilon's values scale by 4: with c = +log_13(3), "
         "h_3 = -(m_2/2) log_13(3) on the vertex R, and E093's c_2 doubles to "
         "h_2 = (m_2/4) log_13(2) by E101 alone.  NONE of this touches the "
         "PARTITION, which is all E092 and E097 take from Gamma_ell, nor the "
         "quadratic Chabauty computation, which uses the MEASURED c_2, c_3 and "
         "never the predicted ones.")

    print("=" * 72)
    print("E102 GATE: %s   (%d failures, %.0f s)"
          % ("GREEN" if not FAIL else "*** RED ***", len(FAIL),
             time.time() - t0))
    for m in FAIL:
        print("   FAILED: %s" % m)


main()
