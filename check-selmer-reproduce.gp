\\ check-selmer-reproduce.gp --- E116: the last [GAP] closed.
\\
\\ Run: gp -q check-selmer-reproduce.gp < /dev/null
\\
\\ THE GAP, AS E050(f) LEFT IT.  dim_F2 Sel^2(Jac X / K) = 5 -- the number that
\\ E044(g) turns into rank_K Jac X <= 3, E051(f) into rank P(Q) = 2, E051(g)
\\ into rank Jac(C_4)(Q) = 3 = g, and E113 into a quadratic Chabauty
\\ computation -- came from a SINGLE remote evaluation of Magma's
\\ TwoSelmerGroup on the free calculator (2026-08-13, 9.2 s).  E050 closed the
\\ question of which convention it is read with, by calibrating over K itself
\\ on five split-Jacobian curves, 5/5.  What E050(f) explicitly did NOT retire:
\\
\\     "the number itself comes from a single remote evaluation that cannot be
\\      reproduced on this machine: if that one run were wrong for a reason
\\      unrelated to convention -- a mistyped input, a different curve --
\\      calibration on five other curves would not catch it.  What would catch
\\      it is re-running the X computation itself."
\\
\\ This script does that, and hardens it in three ways that the original block
\\ had no room for.
\\
\\   (1) THE CURVE IS FINGERPRINTED.  A mistyped input is a DIFFERENT CURVE, and
\\       a different curve has a different zeta function.  The block makes Magma
\\       report #J(F_p) at four degree-one primes of K, the factorisation type of
\\       f over K, the 2-torsion and the genus; every one of those is computed
\\       here first, from the Ritzenthaler-Romagny construction of E039(e)
\\       rebuilt from scratch rather than copied.  If Magma is looking at any
\\       other curve, four L-polynomials will say so.
\\
\\   (2) THE ANSWER IS ASKED FOR THREE TIMES, ON THREE MODELS.  f, its reverse
\\       X^6 f(1/X), and the shift f(X+1) are isomorphic curves over K -- checked
\\       here by their L-polynomials at the same four primes -- but they are
\\       three different inputs to TwoSelmerGroup, and a transcription error in
\\       one of them cannot survive agreement of the three.
\\
\\   (3) IT IS A SECOND RUN.  The original was 2026-08-13; this is a fresh
\\       evaluation of the same mathematics on the same service.
\\
\\ Everything below except the five numbers in section 5 is computed here.

\\ ---------------------------------------------------------------- the curve
\\ E039(e), via Ritzenthaler-Romagny Thm 1.1 for r = 27 T (T^3 - 4 Z^3);
\\ identical code to check-prym-rank.gp, on purpose -- the point is that the
\\ block sent is generated by the construction and not typed.
sextic() =
{
  my(T = 'w^3 - 4, A, Ai, aa, bb, cc);
  A = [Mod(27,T), Mod(-27*'w,T), Mod(0,T);
       Mod(6,T),  Mod(-12,T),    Mod(6,T);
       Mod(1,T),  Mod('w,T),     Mod('w^2,T)];
  Ai = A^-1;
  aa = Ai[1,1] + 2*Ai[2,1]*'x + Ai[3,1]*'x^2;
  bb = Ai[1,2] + 2*Ai[2,2]*'x + Ai[3,2]*'x^2;
  cc = Ai[1,3] + 2*Ai[2,3]*'x + Ai[3,3]*'x^2;
  return(bb*(bb^2 - aa*cc));
};

PRIMES = [5, 11, 17, 23];       \\ degree-one primes of K used as fingerprints

FAIL = 0;
check(c, msg) = { if(c, printf("   [ok]  %s\n", msg),
                     printf("   [FAIL] %s\n", msg); FAIL++); c; };
info(msg) = printf("        %s\n", msg);

\\ the three models, as polynomials over Z[w]/(w^3-4)
models(f) = {
  my(rev = Polrev(Vec(f)), sh = subst(f, 'x, 'x + 1));
  [f, rev, sh];
};

\\ #J(F_p) at a degree-one prime, locally: reduce w to a root of w^3-4 mod p
jcount(f, p) = {
  my(rts = polrootsmod('w^3 - 4, p), wp, fp);
  if(#rts == 0, return(0));
  wp = lift(rts[1]);
  fp = subst(lift(f), 'w, wp) * Mod(1, p);
  if(poldegree(fp) != 6 || poldisc(fp) == 0, return(0));
  subst(hyperellcharpoly(fp), 'x, 1);
};

magmapoly(name, s) = {
  my(str = Str(name, " := "), c, i);
  forstep(i = poldegree(lift(s)), 0, -1,
    c = lift(polcoef(lift(s), i, 'x));
    str = concat([str, "(", Str(c), ")*X^", Str(i), if(i > 0, " + ", ";")]));
  str;
};

{
print("=== check-selmer-reproduce.gp --- E116: reproducing dim Sel^2 = 5 ===");
print("(1) THE CURVE, REBUILT FROM E039(e)'s CONSTRUCTION");
my(s, s2, nf, fa, degs, MOD, cnt, ok, i, j, mods, names, blk);
s = sextic(); s2 = 108^2 * s;
info(Str("f = ", lift(s2)));
check(poldegree(lift(s2)) == 6 && poldisc(lift(s2), 'x) != 0,
      "degree 6 and squarefree, so X : y^2 = f(x) is a genus-2 curve");
check(denominator(content(lift(s2))) == 1,
      "coefficients integral over Z[w] (the 108^2 = 11664 scaling is a square, "
      "so y -> 108 y is an isomorphism and the rank is unchanged)");
nf = nfinit('w^3 - 4);
fa = nffactor(nf, lift(s2));
degs = vecsort(vector(#fa[,1], i, poldegree(fa[i,1])));
check(Vec(degs) == [2,2,2],
      Str("f factors over K into three irreducible quadratics ", Vec(degs),
          ", so the six Weierstrass points fall into three Galois orbits of "
          "size 2, every union of orbits is even, and dim_F2 J(K)[2] = 2 "
          "(E044(e), rederived)"));
info(Str("N_{K/Q} disc(f) = ", nfeltnorm(nf, lift(Mod(poldisc(lift(s2),'x),
                                                      'w^3-4)))));

print("(2) THE FINGERPRINTS, AND THE THREE MODELS");
mods = models(s2); names = ["f", "reverse", "shift"];
MOD = matrix(3, #PRIMES);
for(i = 1, 3, for(j = 1, #PRIMES, MOD[i,j] = jcount(mods[i], PRIMES[j])));
for(i = 1, 3,
  info(Str("  ", names[i], ": #J(F_p) at p = ", PRIMES, " -> ", MOD[i,])));
ok = 1;
for(j = 1, #PRIMES, for(i = 2, 3, if(MOD[i,j] != MOD[1,j], ok = 0)));
check(ok && vecmin(vector(#PRIMES, j, MOD[1,j])) > 0,
      "the reverse X^6 f(1/X) and the shift f(X+1) have the SAME L-polynomial "
      "at all four primes as f, which is what makes them usable as independent "
      "inputs: three different sextics, one curve");
ok = 1;
for(j = 1, #PRIMES, if(MOD[1,j] % 4 != 0, ok = 0));
check(ok,
      Str("and 4 | #J(F_p) at every one of them, as J(K)[2] = (Z/2)^2 forces"));

print("(3) THE MAGMA BLOCK");
print("");
print("// ------------------------------- begin -------------------------------");
print("R<x> := PolynomialRing(Rationals());");
print("K<w> := NumberField(x^3-4);");
print("Kx<X> := PolynomialRing(K);");
for(i = 1, 3, print(magmapoly(Str("f", i), mods[i])));
print("red := function(c,p,wp) s := Eltseq(c);");
print("  return GF(p)!(s[1] + s[2]*wp + s[3]*wp^2); end function;");
print("PR := [[5,4],[11,5],[17,13],[23,3]];");
print("for i in [1..3] do");
print("  f := [f1,f2,f3][i];");
print("  C := HyperellipticCurve(f);  J := Jacobian(C);");
print("  printf \"model %o: dim Sel2 = %o\\n\", i, Ilog(2,#TwoSelmerGroup(J));");
print("  printf \"model %o: genus %o, degrees %o, J2 %o\\n\",");
print("    i, Genus(C), Sort([Degree(t[1]) : t in Factorisation(f)]),");
print("    Invariants(TwoTorsionSubgroup(J));");
print("  printf \"model %o: coeffs %o\\n\", i, [Eltseq(c) : c in Coefficients(f)];");
print("  for pr in PR do");
print("    fp := PolynomialRing(GF(pr[1])) !");
print("      [red(c,pr[1],pr[2]) : c in Coefficients(f)];");
print("    printf \"model %o: #J(F_%o) = %o\\n\", i, pr[1],");
print("      #Jacobian(HyperellipticCurve(fp));");
print("  end for;");
print("end for;");
print("// -------------------------------- end --------------------------------");
print("");
info("expected, if the 2026-08-13 run was right and the curve is this one:");
for(i = 1, 3,
  info(Str("  model ", i, ": genus 2, degrees [2,2,2], J[2] = [2,2], ",
           "#J(F_p) = ", MOD[i,], ", dim Sel2 = 5")));
print("");
}

\\ ------------------------------------------------------------ section 4
\\ Output of the block above on the free Magma calculator, run 2026-08-18 with
\\ the user's authorisation.  These are the ONLY numbers in this script that
\\ were not computed on this machine.  Per model:
\\   [ dim Sel2, genus, factor degrees, J[2] invariants, #J(F_p) for PRIMES,
\\     coefficients of f from the constant term up, each as [c0,c1,c2] ]
\\ NB the braces: a multi-line assignment in a GP SCRIPT FILE must be wrapped
\\ in { }, or each line is parsed as a statement of its own (the same trap
\\ check-c4-rational.gp records for multi-line function definitions).
{
MAGMA = [
 [5, 2, [2,2,2], [2,2], [60,164,372,700],
  [[0,-2,-1],[-28,-10,-4],[-2,-8,-11],[32,28,18],[20,2,8],[-32,-20,-14],[8,6,4]]],
 [5, 2, [2,2,2], [2,2], [60,164,372,700],
  [[8,6,4],[-32,-20,-14],[20,2,8],[32,28,18],[-2,-8,-11],[-28,-10,-4],[0,-2,-1]]],
 [5, 2, [2,2,2], [2,2], [60,164,372,700],
  [[-2,-4,0],[32,2,14],[14,-22,11],[-48,-44,-10],[-20,-8,-2],[16,16,10],[8,6,4]]]
];
}

{
print("(4) COMPARISON WITH THE REMOTE OUTPUT");
my(s2 = 108^2*sextic(), mods, MOD, ok, loc, i, j, k, c);
mods = models(s2);
MOD = matrix(3, #PRIMES);
for(i = 1, 3, for(j = 1, #PRIMES, MOD[i,j] = jcount(mods[i], PRIMES[j])));
ok = 1;
for(i = 1, 3,
  \\ the coefficients Magma actually parsed, against the ones built here
  loc = vector(7, k, Vecrev(Pol(lift(polcoef(lift(mods[i]), k-1, 'x)), 'w), 3));
  for(k = 1, 7,
    c = MAGMA[i][6][k];
    if(#c != 3 || c[1] != loc[k][1] || c[2] != loc[k][2] || c[3] != loc[k][3],
       ok = 0; info(Str("  model ", i, " coefficient ", k-1,
                        ": Magma ", c, " vs local ", loc[k]))));
  if(MAGMA[i][2] != 2, ok = 0);
  if(MAGMA[i][3] != [2,2,2], ok = 0);
  if(MAGMA[i][4] != [2,2], ok = 0);
  for(j = 1, #PRIMES, if(MAGMA[i][5][j] != MOD[i,j], ok = 0));
  info(Str("  model ", i, ": Magma reports genus ", MAGMA[i][2],
           ", degrees ", MAGMA[i][3], ", J[2] ", MAGMA[i][4],
           ", #J(F_p) ", MAGMA[i][5], ", dim Sel2 ", MAGMA[i][1])));
check(ok,
      Str("MAGMA'S CURVE IS OUR CURVE: on all three models the genus, the "
          "factorisation type over K, the 2-torsion, the twenty-one "
          "coefficients as Magma parsed them and all twelve point counts "
          "agree with the local computation.  A mistyped input or a different "
          "curve is excluded -- which is exactly what E050(f) said calibration "
          "on other curves could not do"));
check(MAGMA[1][1] == 5 && MAGMA[2][1] == 5 && MAGMA[3][1] == 5,
      "and dim_F2 Sel^2(Jac X / K) = 5 on all three models, reproducing the "
      "single run of 2026-08-13 that E050(f) left standing alone");
print("");
info("CONSEQUENCES, all of them now with nothing unperformed behind them:");
info("  rank_K Jac X <= 5 - 2 = 3            (E044(g), convention by E050)");
info("  rank P(Q) = 2                        (E051(f))");
info("  rank Jac(C_4)(Q) = 1 + 2 = 3 = g     (E051(g))");
info("  = the standing hypothesis of the quadratic Chabauty computation");
info("    of E113, and hence of C_4(Q) = the nine points (E115).");
print("========================================================================");
printf("E116 GATE: %s   (%d failures)\n", if(FAIL, "*** RED ***", "GREEN"), FAIL);
}
